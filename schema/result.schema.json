{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.schema.json",
  "title": "Result",
  "$comment": "DRAFT. Frozen as schema v1 only at T1's gate (PLAN.md section 7), after the contract has met live data. Uses the keyword subset implemented by tools/validate.py; an unknown keyword is an error there, never ignored.",
  "type": "object",
  "required": [
    "schema_version",
    "units",
    "model_result",
    "execution_readiness",
    "evaluation_scope",
    "baseline",
    "objective_valuation_time",
    "leg_observation_times",
    "worst_case",
    "failing_intervals",
    "profile",
    "cost",
    "comparisons",
    "reason_codes",
    "assumptions",
    "checks_not_performed",
    "engine_version",
    "ir_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "units": {
      "$ref": "defs.schema.json#/$defs/units"
    },
    "model_result": {
      "enum": [
        "passes",
        "fails",
        "needs_review"
      ]
    },
    "execution_readiness": {
      "enum": [
        "not_evaluated",
        "envelope_issued",
        "blocked"
      ]
    },
    "evaluation_scope": {
      "const": "exhaustive_supported_terminal_model"
    },
    "baseline": {
      "$ref": "defs.schema.json#/$defs/baseline"
    },
    "objective_valuation_time": {
      "$ref": "defs.schema.json#/$defs/time"
    },
    "leg_observation_times": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/time"
      }
    },
    "worst_case": {
      "type": "object",
      "required": [
        "pnl",
        "attained",
        "price"
      ],
      "properties": {
        "pnl": {
          "$ref": "defs.schema.json#/$defs/number"
        },
        "attained": {
          "type": "boolean"
        },
        "price": {
          "$ref": "defs.schema.json#/$defs/number"
        }
      },
      "additionalProperties": false
    },
    "failing_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lower",
          "lower_inclusive",
          "upper",
          "upper_inclusive",
          "clause",
          "witness"
        ],
        "properties": {
          "lower": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "lower_inclusive": {
            "type": "boolean"
          },
          "upper": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "upper_inclusive": {
            "type": "boolean"
          },
          "clause": {
            "$ref": "defs.schema.json#/$defs/slug"
          },
          "witness": {
            "$ref": "defs.schema.json#/$defs/witness"
          }
        },
        "additionalProperties": false
      }
    },
    "undecided_intervals": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/interval"
      },
      "description": "Where the only violations rest on a loose bound: needs_review, never fails."
    },
    "profile": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "lower",
          "lower_inclusive",
          "upper",
          "upper_inclusive",
          "slope",
          "intercept"
        ],
        "properties": {
          "lower": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "lower_inclusive": {
            "type": "boolean"
          },
          "upper": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "upper_inclusive": {
            "type": "boolean"
          },
          "slope": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "intercept": {
            "$ref": "defs.schema.json#/$defs/number"
          }
        },
        "additionalProperties": false
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "premium",
        "other_costs",
        "pnl_at_baseline",
        "breakevens"
      ],
      "properties": {
        "premium": {
          "$ref": "defs.schema.json#/$defs/number"
        },
        "other_costs": {
          "$ref": "defs.schema.json#/$defs/number"
        },
        "pnl_at_baseline": {
          "$ref": "defs.schema.json#/$defs/number"
        },
        "breakevens": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/number"
          }
        }
      },
      "additionalProperties": false
    },
    "comparisons": {
      "type": "object",
      "required": [
        "no_hedge",
        "smallest_reduction"
      ],
      "properties": {
        "no_hedge": {
          "type": "object",
          "required": [
            "worst_case",
            "failing_intervals",
            "proposal_better",
            "proposal_worse"
          ],
          "properties": {
            "worst_case": {
              "type": "object",
              "required": [
                "pnl",
                "price"
              ],
              "properties": {
                "pnl": {
                  "$ref": "defs.schema.json#/$defs/number"
                },
                "price": {
                  "$ref": "defs.schema.json#/$defs/number"
                }
              },
              "additionalProperties": false
            },
            "failing_intervals": {
              "type": "array",
              "items": {
                "$ref": "defs.schema.json#/$defs/interval"
              }
            },
            "proposal_better": {
              "type": "array",
              "items": {
                "$ref": "defs.schema.json#/$defs/interval"
              }
            },
            "proposal_worse": {
              "type": "array",
              "items": {
                "$ref": "defs.schema.json#/$defs/interval"
              }
            }
          },
          "additionalProperties": false
        },
        "smallest_reduction": {
          "description": "The smallest exposure reduction meeting the same clauses: keep this much, sell the rest at the baseline, hold the cash. It costs no premium, so it is the benchmark a paid hedge has to beat.",
          "type": "object",
          "required": [
            "keep_quantity",
            "sell_quantity",
            "sell_at",
            "worst_case",
            "proposal_better",
            "proposal_worse"
          ],
          "properties": {
            "keep_quantity": {
              "$ref": "defs.schema.json#/$defs/number"
            },
            "sell_quantity": {
              "$ref": "defs.schema.json#/$defs/number"
            },
            "sell_at": {
              "$ref": "defs.schema.json#/$defs/number"
            },
            "worst_case": {
              "type": "object",
              "required": [
                "pnl",
                "price"
              ],
              "properties": {
                "pnl": {
                  "$ref": "defs.schema.json#/$defs/number"
                },
                "price": {
                  "$ref": "defs.schema.json#/$defs/number"
                }
              },
              "additionalProperties": false
            },
            "proposal_better": {
              "type": "array",
              "items": {
                "$ref": "defs.schema.json#/$defs/interval"
              }
            },
            "proposal_worse": {
              "type": "array",
              "items": {
                "$ref": "defs.schema.json#/$defs/interval"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/code"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/slug"
      }
    },
    "checks_not_performed": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/code"
      }
    },
    "engine_version": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "ir_digest": {
      "$ref": "defs.schema.json#/$defs/sha256"
    },
    "proposal_digest": {
      "$ref": "defs.schema.json#/$defs/sha256"
    },
    "input_digest": {
      "$ref": "defs.schema.json#/$defs/sha256"
    },
    "semantics_version": {
      "$ref": "defs.schema.json#/$defs/sha256"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/sha256"
      }
    },
    "size_windows": {
      "description": "For each book-walked leg, the sizes that would have met every clause on the book the walk saw. Exact bounds, the whole-contract window inside them, and which site binds each end. An empty window at a flat price carries the Farkas weights that prove no size works.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "leg",
          "status",
          "binding"
        ],
        "properties": {
          "leg": {
            "$ref": "defs.schema.json#/$defs/leg_id"
          },
          "status": {
            "enum": [
              "nonempty",
              "empty"
            ]
          },
          "lower_bound": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "upper_bound": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "smallest": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "largest": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "binding": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "price",
                "side"
              ],
              "properties": {
                "price": {
                  "$ref": "defs.schema.json#/$defs/number"
                },
                "side": {
                  "enum": [
                    "at",
                    "above",
                    "below"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "certificate": {
            "type": "object",
            "required": [
              "kind",
              "weights"
            ],
            "properties": {
              "kind": {
                "const": "farkas"
              },
              "weights": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "$ref": "defs.schema.json#/$defs/number"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "dependentRequired": {
          "smallest": [
            "largest"
          ],
          "largest": [
            "smallest"
          ],
          "lower_bound": [
            "upper_bound"
          ],
          "upper_bound": [
            "lower_bound"
          ]
        }
      }
    },
    "reductions": {
      "description": "Every lowering rule that lowered a leg's value, copied from the lowered proposal so the result is self-contained. A rule that is not tight can never produce a failing interval.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "leg",
          "rule",
          "tight",
          "reason_code"
        ],
        "properties": {
          "leg": {
            "$ref": "defs.schema.json#/$defs/leg_id"
          },
          "rule": {
            "$ref": "defs.schema.json#/$defs/slug"
          },
          "tight": {
            "type": "boolean"
          },
          "reason_code": {
            "$ref": "defs.schema.json#/$defs/code"
          }
        },
        "additionalProperties": false
      }
    },
    "upper_profile": {
      "description": "The best the proposal could be: every reduced leg credited with its full size, which a long fully collateralized token can never exceed. Present only when a reduction applied. A violation the upper profile does not share is undecided, never a failure.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "lower",
          "lower_inclusive",
          "upper",
          "upper_inclusive",
          "slope",
          "intercept"
        ],
        "properties": {
          "lower": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "lower_inclusive": {
            "type": "boolean"
          },
          "upper": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "upper_inclusive": {
            "type": "boolean"
          },
          "slope": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "intercept": {
            "$ref": "defs.schema.json#/$defs/number"
          }
        },
        "additionalProperties": false
      }
    },
    "capture": {
      "$ref": "defs.schema.json#/$defs/capture"
    }
  },
  "additionalProperties": false
}
