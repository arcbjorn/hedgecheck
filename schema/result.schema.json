{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.schema.json",
  "title": "Result",
  "$comment": "DRAFT. Frozen as schema v1 only at T1's gate (PLAN.md section 7), after the contract has met live data. Uses the keyword subset implemented by tools/validate.py; an unknown keyword is an error there, never ignored.",
  "type": "object",
  "required": [
    "schema_version",
    "units",
    "model_result",
    "execution_readiness",
    "evaluation_scope",
    "baseline",
    "objective_valuation_time",
    "leg_observation_times",
    "worst_case",
    "failing_intervals",
    "profile",
    "cost",
    "comparisons",
    "reason_codes",
    "assumptions",
    "checks_not_performed",
    "engine_version",
    "ir_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "units": {
      "$ref": "defs.schema.json#/$defs/units"
    },
    "model_result": {
      "enum": [
        "passes",
        "fails",
        "needs_review"
      ]
    },
    "execution_readiness": {
      "enum": [
        "not_evaluated",
        "envelope_issued",
        "blocked"
      ]
    },
    "evaluation_scope": {
      "const": "exhaustive_supported_terminal_model"
    },
    "baseline": {
      "$ref": "defs.schema.json#/$defs/baseline"
    },
    "objective_valuation_time": {
      "$ref": "defs.schema.json#/$defs/time"
    },
    "leg_observation_times": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/time"
      }
    },
    "worst_case": {
      "type": "object",
      "required": [
        "pnl",
        "attained",
        "price"
      ],
      "properties": {
        "pnl": {
          "$ref": "defs.schema.json#/$defs/number"
        },
        "attained": {
          "type": "boolean"
        },
        "price": {
          "$ref": "defs.schema.json#/$defs/number"
        }
      },
      "additionalProperties": false
    },
    "failing_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lower",
          "lower_inclusive",
          "upper",
          "upper_inclusive",
          "clause",
          "witness"
        ],
        "properties": {
          "lower": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "lower_inclusive": {
            "type": "boolean"
          },
          "upper": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "upper_inclusive": {
            "type": "boolean"
          },
          "clause": {
            "$ref": "defs.schema.json#/$defs/slug"
          },
          "witness": {
            "$ref": "defs.schema.json#/$defs/witness"
          }
        },
        "additionalProperties": false
      }
    },
    "undecided_intervals": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/interval"
      },
      "description": "Where the only violations rest on a loose bound: needs_review, never fails."
    },
    "profile": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "lower",
          "lower_inclusive",
          "upper",
          "upper_inclusive",
          "slope",
          "intercept"
        ],
        "properties": {
          "lower": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "lower_inclusive": {
            "type": "boolean"
          },
          "upper": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "upper_inclusive": {
            "type": "boolean"
          },
          "slope": {
            "$ref": "defs.schema.json#/$defs/number"
          },
          "intercept": {
            "$ref": "defs.schema.json#/$defs/number"
          }
        },
        "additionalProperties": false
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "premium",
        "other_costs",
        "pnl_at_baseline",
        "breakevens"
      ],
      "properties": {
        "premium": {
          "$ref": "defs.schema.json#/$defs/number"
        },
        "other_costs": {
          "$ref": "defs.schema.json#/$defs/number"
        },
        "pnl_at_baseline": {
          "$ref": "defs.schema.json#/$defs/number"
        },
        "breakevens": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/number"
          }
        }
      },
      "additionalProperties": false
    },
    "comparisons": {
      "type": "object",
      "required": [
        "no_hedge"
      ],
      "properties": {
        "no_hedge": {
          "type": "object",
          "required": [
            "worst_case",
            "failing_intervals",
            "proposal_better",
            "proposal_worse"
          ],
          "properties": {
            "worst_case": {
              "type": "object",
              "required": [
                "pnl",
                "price"
              ],
              "properties": {
                "pnl": {
                  "$ref": "defs.schema.json#/$defs/number"
                },
                "price": {
                  "$ref": "defs.schema.json#/$defs/number"
                }
              },
              "additionalProperties": false
            },
            "failing_intervals": {
              "type": "array",
              "items": {
                "$ref": "defs.schema.json#/$defs/interval"
              }
            },
            "proposal_better": {
              "type": "array",
              "items": {
                "$ref": "defs.schema.json#/$defs/interval"
              }
            },
            "proposal_worse": {
              "type": "array",
              "items": {
                "$ref": "defs.schema.json#/$defs/interval"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/code"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/slug"
      }
    },
    "checks_not_performed": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/code"
      }
    },
    "engine_version": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "ir_digest": {
      "$ref": "defs.schema.json#/$defs/sha256"
    },
    "proposal_digest": {
      "$ref": "defs.schema.json#/$defs/sha256"
    },
    "input_digest": {
      "$ref": "defs.schema.json#/$defs/sha256"
    },
    "semantics_version": {
      "$ref": "defs.schema.json#/$defs/sha256"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/sha256"
      }
    }
  },
  "additionalProperties": false
}
